<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <!-- Lets the WPF shell restore and compile on non-Windows machines (it
         still only *runs* on Windows). The core and its tests are plain
         net8.0 and run anywhere. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
</Project>
